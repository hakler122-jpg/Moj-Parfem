<!DOCTYPE html>
<html lang="sr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moj Parfem</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#000;
    overflow:hidden;
}

/* MENU */

nav{
    position:fixed;
    top:0;
    width:100%;
    background:#fff;
    display:flex;
    justify-content:center;
    gap:40px;
    padding:18px;
    z-index:1000;
}

.dropdown{
    position:relative;
}

.dropdown a{
    text-decoration:none;
    color:#000;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:2px;
}

.dropdown-content{
    display:none;
    position:absolute;
    background:white;
    min-width:180px;
    top:30px;
    left:0;
    box-shadow:0 10px 20px rgba(0,0,0,.2);
}

.dropdown-content a{
    display:block;
    padding:12px;
}

.dropdown:hover .dropdown-content{
    display:block;
}

/* HERO */

.hero{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.frame{
    width:92%;
    height:85%;
    border:1px solid white;
    position:relative;
}

/* DEKORATIVNE LINIJE */

.line1{
    position:absolute;
    top:100px;
    left:100px;
    width:250px;
    height:1px;
    background:white;
}

.line2{
    position:absolute;
    bottom:100px;
    right:100px;
    width:250px;
    height:1px;
    background:white;
}

.line3{
    position:absolute;
    top:120px;
    right:120px;
    width:1px;
    height:200px;
    background:white;
}

.line4{
    position:absolute;
    bottom:120px;
    left:120px;
    width:1px;
    height:200px;
    background:white;
}

/* NASLOV */

.title{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    color:white;
    z-index:10;
}

.title h1{
    font-size:90px;
    font-weight:100;
    letter-spacing:20px;
}

.title p{
    margin-top:15px;
    color:#aaa;
    letter-spacing:5px;
    text-transform:uppercase;
}

/* 3D PARFEM */

.perfume{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:220px;
    height:320px;
    animation:rotate 12s linear infinite;
    transform-style:preserve-3d;
}

.bottle{
    width:100%;
    height:100%;
    border:2px solid rgba(255,255,255,.8);
    background:linear-gradient(
        to bottom,
        rgba(255,255,255,.15),
        rgba(255,255,255,.02)
    );
    border-radius:20px;
    position:relative;
}

.cap{
    width:90px;
    height:50px;
    background:white;
    position:absolute;
    top:-50px;
    left:50%;
    transform:translateX(-50%);
}

@keyframes rotate{
    from{
        transform:
        translate(-50%,-50%)
        rotateY(0deg);
    }
    to{
        transform:
        translate(-50%,-50%)
        rotateY(360deg);
    }
}

@media(max-width:768px){

.title h1{
    font-size:45px;
    letter-spacing:8px;
}

.perfume{
    width:150px;
    height:220px;
}

}

</style>
</head>
<body>

<nav>

<div class="dropdown">
<a href="#">Muški</a>
<div class="dropdown-content">
<a href="#">Dior</a>
<a href="#">Tom Ford</a>
<a href="#">Versace</a>
</div>
</div>

<div class="dropdown">
<a href="#">Ženski</a>
<div class="dropdown-content">
<a href="#">Chanel</a>
<a href="#">YSL</a>
<a href="#">Gucci</a>
</div>
</div>

<div class="dropdown">
<a href="#">Brendovi</a>
<div class="dropdown-content">
<a href="#">Armani</a>
<a href="#">Dior</a>
<a href="#">Prada</a>
</div>
</div>

</nav>

<section class="hero">

<div class="frame">

<div class="line1"></div>
<div class="line2"></div>
<div class="line3"></div>
<div class="line4"></div>

<div class="perfume">
<div class="bottle">
<div class="cap"></div>
</div>
</div>

<div class="title">
<h1>MOJ PARFEM</h1>
<p>Originalni parfemi vrhunskog kvaliteta</p>
</div>

</div>

</section>

</body>
</html>
